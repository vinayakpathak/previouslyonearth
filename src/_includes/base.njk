{% from "icons.njk" import star %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f5f2e9">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  {% if site.url %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/cormorant-garamond-regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/cormorant-garamond-italic.woff2" as="font" type="font/woff2" crossorigin>
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/styles.css">
  <script src="/assets/site.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header{% if page.url == '/' %} site-header--home{% endif %} wrap">
    {% if page.url == '/' %}
      <h1 class="masthead"><a href="/" aria-label="{{ site.title }}, home"><span>Previously</span> <em>on Earth.</em></a></h1>
    {% else %}
      <a class="wordmark" href="/" aria-label="Previously on Earth, home">{{ star() }}<span>Previously on Earth<span class="wordmark-period">.</span></span></a>
    {% endif %}
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/bookshelf/" {% if section == "bookshelf" %}aria-current="page"{% endif %}>Bookshelf</a>
      <a href="/about/" {% if section == "about" %}aria-current="page"{% endif %}>About</a>
    </nav>
    <div class="header-tools">
      <button class="icon-button" type="button" data-open-search aria-label="Search articles and books" title="Search (⌘ K)"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.8" stroke="currentColor" stroke-width="1.4"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.4"/></svg></button>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer wrap">
    <div class="footer-bottom"><span>© {{ site.year }} Previously on Earth</span><button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark appearance"><span class="theme-dot" aria-hidden="true"></span><span data-theme-label>Dark mode</span></button></div>
  </footer>
  <dialog class="search-dialog" aria-labelledby="search-title">
    <div class="search-top"><h2 id="search-title">Search</h2><button class="icon-button close-search" type="button" aria-label="Close search">×</button></div>
    <label class="sr-only" for="search-input">Search articles and books</label>
    <input id="search-input" type="search" placeholder="Search articles and books" autocomplete="off">
    <div class="search-results" aria-live="polite"></div>
    <div class="search-bottom"><kbd>esc to close</kbd></div>
  </dialog>
</body>
</html>

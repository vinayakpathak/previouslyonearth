---
layout: base.njk
section: articles
ogType: article
---
{% from "icons.njk" import arrow, star %}
<div class="reading-progress" aria-hidden="true"><span></span></div>
<article class="post wrap">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time class="entry-date" datetime="{{ page.date | dateISO }}">{{ page.date | dateLabel }}</time>
  </header>
  <div class="post-body prose">{{ content | safe }}<div class="post-end" aria-hidden="true">{{ star() }}</div></div>
  <div class="post-bottom"><a class="text-link" href="/#articles">Back to articles {{ arrow() }}</a></div>
</article>

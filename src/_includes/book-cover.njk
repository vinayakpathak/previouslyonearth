{% if book.cover %}
<img class="book-cover-image" src="{{ book.cover }}" alt="{{ book.coverAlt or ('Cover of ' + book.title + ' by ' + book.author) }}" width="{{ book.coverWidth or 200 }}" height="{{ book.coverHeight or 300 }}" loading="lazy" decoding="async">
{% else %}
<div class="book-cover" aria-label="{{ book.title }} by {{ book.author }}" style="--book-color: {{ book.color or '#743c32' }}">
  <span class="book-cover-author">{{ book.author }}</span><span class="book-cover-rule"></span><span class="book-cover-title{% if book.title.length > 9 %} book-cover-title-long{% endif %}{% if book.title.length > 25 %} book-cover-title-longer{% endif %}">{{ book.title }}</span><span class="book-cover-subtitle">{{ book.subtitle }}</span><svg class="book-cover-laurel" viewBox="0 0 80 72" fill="none" aria-hidden="true"><path d="M39 66C6 52 7 23 21 7M41 66c33-14 32-43 18-59" stroke="currentColor" stroke-width="1.2"/><path d="M16 18C7 18 6 8 8 4c7 3 9 8 8 14Zm-4 13C3 29 1 20 3 16c7 3 10 8 9 15Zm3 13C5 44 0 36 1 31c8 2 13 6 14 13Zm8 12C13 58 5 52 5 47c9 0 15 3 18 9Zm11 9c-9 5-18 2-20-3 8-3 15-2 20 3ZM16 22c9-1 13-9 12-14-8 2-12 7-12 14Zm-3 14c10-3 13-9 12-15-8 3-12 8-12 15Zm5 14c9-5 11-13 8-17-7 4-10 10-8 17Zm9 10c8-7 7-15 4-19-7 6-8 12-4 19Z" fill="currentColor"/><path d="M64 18c9 0 10-10 8-14-7 3-9 8-8 14Zm4 13c9-2 11-11 9-15-7 3-10 8-9 15Zm-3 13c10 0 15-8 14-13-8 2-13 6-14 13Zm-8 12c10 2 18-4 18-9-9 0-15 3-18 9Zm-11 9c9 5 18 2 20-3-8-3-15-2-20 3ZM64 22c-9-1-13-9-12-14 8 2 12 7 12 14Zm3 14c-10-3-13-9-12-15 8 3 12 8 12 15Zm-5 14c-9-5-11-13-8-17 7 4 10 10 8 17Zm-9 10c-8-7-7-15-4-19 7 6 8 12 4 19Z" fill="currentColor"/></svg>
</div>
{% endif %}

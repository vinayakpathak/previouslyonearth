---
layout: base.njk
title: Bookshelf
description: A list of history books.
section: bookshelf
permalink: /bookshelf/
---
<div class="wrap">
  <header class="page-intro"><h1><em>Bookshelf</em></h1></header>
  <ul class="books-list" role="list">
    {% for book in books %}
    <li class="shelf-book" id="{{ book.id }}">
      <div class="shelf-book-art">{% include "book-cover.njk" %}</div>
      <div class="shelf-book-copy">
        <h2><a href="{{ book.url }}" target="_blank" rel="noopener noreferrer">{{ book.title }}</a></h2>
        {% if book.subtitle %}<p class="book-subtitle">{{ book.subtitle }}</p>{% endif %}
        <p class="book-author">{{ book.author }}{% if book.year %} <span>· {{ book.year }}</span>{% endif %}</p>
      </div>
    </li>
    {% endfor %}
  </ul>
</div>

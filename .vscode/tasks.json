{
  // Cmd+Shift+B runs the default build task: typeset previously-on-earth.pdf.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typeset the book",
      "type": "shell",
      "command": "make",
      "options": {
        "env": { "PATH": "${env:HOME}/.local/bin:${env:PATH}" }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    }
  ]
}
